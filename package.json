{
  "name": "earthnow",
  "private": true,
  "version": "0.1.0",
  "description": "Street-level geography guessing game.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./server --filter ./client run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . && pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter ./client run test:e2e",
    "seed": "pnpm --filter ./server run seed",
    "locations:generate": "pnpm --filter ./server run locations:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
