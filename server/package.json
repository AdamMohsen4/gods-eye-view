{
  "name": "@earthnow/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/main.ts",
    "start": "tsx src/main.ts",
    "start:test": "IMAGERY_PROVIDER=fixture DATABASE_URL=memory:// SEED_ON_BOOT=1 ADMIN_TOKEN=test-admin RATE_LIMIT_MAX=100000 tsx src/main.ts",
    "seed": "node --env-file-if-exists=../.env --import tsx src/scripts/seed.ts",
    "locations:generate": "node --env-file-if-exists=../.env --import tsx src/scripts/generateLocations.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@earthnow/db": "workspace:*",
    "@earthnow/shared": "workspace:*",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.3.7",
    "@mapbox/vector-tile": "2.0.5",
    "all-the-cities": "^3.1.0",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "i18n-iso-countries": "^7.14.0",
    "pbf": "4.0.2",
    "sharp": "^0.34.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/ws": "^8.18.2"
  }
}
