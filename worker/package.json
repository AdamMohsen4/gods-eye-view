{
  "name": "@earthnow/worker",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "node --env-file-if-exists=../.env --import tsx src/seed.ts",
    "record": "tsx src/record.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@earthnow/db": "workspace:*",
    "@earthnow/shared": "workspace:*",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.44.0",
    "satellite.js": "^6.0.2",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5"
  }
}
