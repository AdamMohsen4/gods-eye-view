# --- Mode -------------------------------------------------------------
# FIXTURE_MODE=1 (default in dev/tests): providers read recorded files in /fixtures.
# LIVE_DATA=1: hit real providers. Never set both.
FIXTURE_MODE=1
# LIVE_DATA=1

# --- Database ---------------------------------------------------------
# Unset = embedded PGlite in ./.data/pg (dev only). Production: EU-region Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/earthnow

# --- Providers (server-side only; never exposed to the client) --------
# FlyItalyADSB, ADSBx-v2-compatible API. Pro plan = worldwide radius.
FLYITALYADSB_API_KEY=
FLYITALYADSB_PLAN=free            # free | starter | pro (controls query radius strategy)
# NASA FIRMS uses the keyless 24h global CSV; no key needed.

# --- Server -----------------------------------------------------------
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_TOKEN=change-me             # bearer token for /api/admin/* until Clerk lands
ROUND_TIMER_SECONDS=60
ARCADE_FREE_ROUNDS_PER_DAY=5

# --- Client -----------------------------------------------------------
# esri (keyless, commercial terms unconfirmed) | offline (bundled NaturalEarthII) | ion
VITE_IMAGERY=esri
VITE_CESIUM_ION_TOKEN=
