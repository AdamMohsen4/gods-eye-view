# --- Imagery ------------------------------------------------------------
# fixture (generated panoramas, no keys) | mapillary | google
IMAGERY_PROVIDER=fixture
# Mapillary: create an app at https://www.mapillary.com/dashboard/developers (free).
# The client token is used by the browser viewer and by the server for the Graph API.
MAPILLARY_TOKEN=
# MAPILLARY_CLIENT_TOKEN=        # only if the browser should use a different token
# Google: two keys. Server key = Street View metadata (no charge per call).
# Browser key = Maps JavaScript API, HTTP-referrer restricted. Billed per panorama load.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Guess map tiles: openfreemap (keyless vector tiles) | offline (bundled outlines)
MAP_STYLE=openfreemap

# --- Database -----------------------------------------------------------
# Unset = PGlite in ./.data/pg (local dev). Production: postgres://…
# DATABASE_URL=

# --- Server -------------------------------------------------------------
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_TOKEN=change-me
DUEL_COUNTDOWN_SECONDS=15
# Behind a reverse proxy: its hop count (e.g. 1) or IPs. Leave false when exposed directly.
TRUST_PROXY=false
